# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://tracery:tracery@localhost:5433/tracery

# ─── Model provider layer (LiteLLM) ──────────────────────────────────────────
# LLM_PROVIDER controls how the provider layer behaves:
#   mock    -> deterministic, no API key, runs everything (default; used in CI/tests)
#   litellm -> real calls via LiteLLM, model string decides the vendor
LLM_PROVIDER=mock

# Model strings are LiteLLM identifiers (vendor/model). Used when LLM_PROVIDER=litellm.
DEFAULT_MODEL=anthropic/claude-3-5-sonnet-latest
DEFAULT_EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536

# Provider keys — read from env ONLY, never from the graph spec or client.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ─── API ─────────────────────────────────────────────────────────────────────
# Simple bearer token gate for v1 (single user). Leave blank to disable auth.
API_KEY=
# Public base URL used when generating deployment endpoint URLs.
PUBLIC_BASE_URL=http://localhost:8000
# CORS — comma separated origins for the frontend dev server.
CORS_ORIGINS=http://localhost:5173

# ─── Limits ──────────────────────────────────────────────────────────────────
MAX_INPUT_CHARS=20000
NODE_TIMEOUT_S=60
